<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_bg_deep"
    android:clipChildren="false"
    android:clipToPadding="false">
    <FrameLayout
        android:id="@+id/heroStage"
        android:layout_width="match_parent"
        android:layout_height="0mm"
        android:layout_weight="1"
        android:clipChildren="true">
        <ImageView
            android:id="@+id/ivBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.56" />
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_home_hero_mask" />
        <ImageView
            android:id="@+id/ivHeroPoster"
            android:layout_width="@dimen/home_hero_poster_width"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/vs_12"
            android:layout_marginBottom="@dimen/vs_12"
            android:layout_gravity="right|center_vertical"
            android:layout_marginRight="@dimen/vs_100"
            android:scaleType="fitCenter" />
        <LinearLayout
            android:id="@+id/heroInfo"
            android:layout_width="@dimen/home_hero_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|left"
            android:layout_marginLeft="@dimen/home_page_inset"
            android:layout_marginBottom="@dimen/vs_12"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">
            <TextView
                android:id="@+id/tvHeroName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="发现下一部好片"
                android:textColor="@color/home_text_primary"
                android:textSize="@dimen/ts_50"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvHeroMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_8"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/home_text_secondary"
                android:textSize="@dimen/ts_18" />
            <TextView
                android:id="@+id/tvHeroDesc"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_48"
                android:layout_marginTop="@dimen/vs_8"
                android:ellipsize="end"
                android:maxLines="2"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/home_text_secondary"
                android:textSize="@dimen/ts_18" />
            <LinearLayout
                android:id="@+id/heroActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_24"
                android:orientation="horizontal"
                android:clipChildren="false">
                <TextView
                    android:id="@+id/btnHeroPlay"
                    style="@style/HomeActionText"
                    android:layout_width="@dimen/vs_190"
                    android:layout_height="56mm"
                    android:drawablePadding="@dimen/vs_10"
                    android:paddingLeft="@dimen/vs_28"
                    android:paddingRight="@dimen/vs_28"
                    android:background="@drawable/bg_home_btn_primary"
                    android:text="立即播放"
                    android:drawableStart="@drawable/ic_home_play_action"
                    android:textSize="@dimen/ts_22"
                    android:textStyle="bold"
                    android:nextFocusRight="@id/btnHeroSearch"
                    android:nextFocusDown="@id/tabContinue" />
                <TextView
                    android:id="@+id/btnHeroSearch"
                    style="@style/HomeActionText"
                    android:layout_width="@dimen/vs_190"
                    android:layout_height="56mm"
                    android:drawablePadding="@dimen/vs_10"
                    android:layout_marginLeft="@dimen/vs_14"
                    android:paddingLeft="@dimen/vs_24"
                    android:paddingRight="@dimen/vs_24"
                    android:background="@drawable/bg_home_btn_secondary"
                    android:text="搜索片源"
                    android:drawableStart="@drawable/ic_home_search_action"
                    android:textSize="@dimen/ts_22"
                    android:nextFocusLeft="@id/btnHeroPlay"
                    android:nextFocusDown="@id/tabRecommendations" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/hotHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_44"
        android:paddingLeft="@dimen/home_page_inset"
        android:paddingRight="@dimen/home_page_inset"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tabContinue"
            style="@style/HomeActionText"
            android:background="@drawable/bg_home_shelf_tab"
            android:text="继续观看"
            android:textSize="@dimen/ts_22"
            android:textStyle="bold"
            android:nextFocusRight="@id/tabRecommendations"
            android:nextFocusDown="@id/tvHotList"
            android:nextFocusUp="@id/btnHeroPlay" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_10"
            android:layout_marginRight="@dimen/vs_10"
            android:text="│"
            android:textColor="@color/home_surface_stroke"
            android:textSize="@dimen/ts_20" />
        <TextView
            android:id="@+id/tabRecommendations"
            style="@style/HomeActionText"
            android:background="@drawable/bg_home_shelf_tab"
            android:text="站点推荐"
            android:textSize="@dimen/ts_22"
            android:nextFocusLeft="@id/tabContinue"
            android:nextFocusRight="@id/btnAllHistory"
            android:nextFocusDown="@id/tvHotList"
            android:nextFocusUp="@id/btnHeroPlay" />
        <Space android:layout_width="0mm" android:layout_height="1mm" android:layout_weight="1"/>
        <TextView
            android:id="@+id/btnAllHistory"
            style="@style/HomeActionText"
            android:text="全部历史  ›"
            android:textSize="@dimen/ts_18"
            android:nextFocusLeft="@id/tabRecommendations"
            android:nextFocusDown="@id/tvHotList" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_shelf_height"
        android:layout_marginTop="@dimen/vs_8"
        android:layout_marginBottom="@dimen/vs_24"
        android:clipChildren="false"
        android:clipToPadding="false">
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/tvHotList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="@dimen/home_page_inset"
            android:paddingRight="@dimen/home_page_inset"
            android:paddingTop="@dimen/vs_8"
            android:paddingBottom="@dimen/vs_8"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_14"
            app:tv_selectedItemIsCentered="false" />
        <TextView
            android:id="@+id/emptyHomeShelf"
            style="@style/HomeActionText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/home_page_inset"
            android:layout_marginRight="@dimen/home_page_inset"
            android:background="@drawable/bg_home_btn_secondary"
            android:gravity="center"
            android:textSize="@dimen/ts_22"
            android:text="暂无观看记录，按确定查看站点推荐"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
