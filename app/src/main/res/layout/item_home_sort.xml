<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/vs_48"
    android:background="@drawable/button_home_sort_focus"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:paddingLeft="@dimen/vs_24"
    android:paddingRight="@dimen/vs_24">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:textColor="@color/home_text_secondary"
            android:textSize="@dimen/ts_28" />

        <ImageView
            android:id="@+id/tvFilter"
            android:layout_width="@dimen/vs_24"
            android:layout_height="@dimen/vs_24"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/vs_5"
            android:layout_marginLeft="@dimen/vs_5"
            android:src="@drawable/icon_filter"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/tvFilterColor"
            android:layout_width="@dimen/vs_24"
            android:layout_height="@dimen/vs_24"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/vs_5"
            android:layout_marginLeft="@dimen/vs_5"
            android:src="@drawable/icon_filter_color"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 焦点时的底部强调线 -->
    <View
        android:layout_width="@dimen/vs_40"
        android:layout_height="@dimen/vs_2"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/vs_4"
        android:background="@drawable/bg_home_tab_indicator"
        android:duplicateParentState="true" />

</FrameLayout>
