<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/home_poster_width"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/mItemFrame"
        android:layout_width="@dimen/home_poster_width"
        android:layout_height="@dimen/home_poster_height"
        android:duplicateParentState="true"
        android:background="@drawable/bg_home_poster_card"
        android:padding="@dimen/vs_2">

        <ImageView
            android:id="@+id/ivThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- 左上角进度/评分徽章 -->
        <TextView
            android:id="@+id/tvNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginLeft="@dimen/vs_10"
            android:layout_marginTop="@dimen/vs_10"
            android:background="@drawable/bg_home_chip_glass"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="@dimen/vs_10"
            android:paddingTop="@dimen/vs_4"
            android:paddingRight="@dimen/vs_10"
            android:paddingBottom="@dimen/vs_4"
            android:singleLine="true"
            android:textColor="@color/home_text_primary"
            android:textSize="@dimen/ts_14" />

        <!-- 右下角来源信息（仅“继续观看”模式显示） -->
        <TextView
            android:id="@+id/tvRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginRight="@dimen/vs_10"
            android:layout_marginBottom="@dimen/vs_10"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:shadowColor="#B3000000"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:textColor="@color/home_text_secondary"
            android:textSize="@dimen/ts_14" />

        <FrameLayout
            android:id="@+id/delFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/shape_user_delete"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="@dimen/vs_80"
                android:layout_height="@dimen/vs_80"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/vs_20"
                android:src="@drawable/icon_delete" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvName"
        android:layout_width="@dimen/home_poster_width"
        android:layout_height="@dimen/vs_24"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:layout_marginTop="@dimen/vs_8"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="Title"
        android:textColor="@color/home_text_primary"
        android:textSize="@dimen/ts_18"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="@dimen/home_poster_width"
        android:layout_height="@dimen/home_poster_meta_height"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:layout_marginTop="@dimen/vs_4"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/home_text_tertiary"
        android:textSize="@dimen/ts_14" />

</LinearLayout>
