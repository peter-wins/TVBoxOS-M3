<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_75"
        android:background="@drawable/bg_home_top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_40"
        android:paddingRight="@dimen/vs_40"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center_vertical"
            android:letterSpacing="0.06"
            android:maxWidth="@dimen/vs_240"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/home_text_primary"
            android:textSize="@dimen/ts_20"
            android:textStyle="bold" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridView"
            android:layout_width="@dimen/vs_0"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_35"
            android:layout_marginRight="@dimen/vs_24"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:tv_selectedItemIsCentered="true" />

        <LinearLayout
            android:id="@+id/btnHomeSearch"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_35"
            android:background="@drawable/bg_home_search_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_16"
            android:paddingRight="@dimen/vs_16">

            <ImageView
                android:layout_width="@dimen/vs_20"
                android:layout_height="@dimen/vs_20"
                android:focusable="false"
                android:src="@drawable/icon_search"
                android:tint="@color/home_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_6"
                android:focusable="false"
                android:text="搜索影片"
                android:textColor="@color/home_text_secondary"
                android:textSize="@dimen/ts_16" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_20"
            android:alpha="0.85"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:textAlignment="gravity"
            android:textColor="@color/home_text_secondary"
            android:textSize="@dimen/ts_16"
            tools:text="22:14" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="@dimen/vs_0"
        android:layout_height="@dimen/vs_0"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topLayout">

        <com.github.tvbox.osc.ui.tv.widget.NoScrollViewPager
            android:id="@+id/mViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
