<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 焦点态：暖金描边 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20mm" />
            <solid android:color="@color/home_accent_soft" />
            <stroke android:width="2mm" android:color="@color/home_accent" />
        </shape>
    </item>
    <!-- 常态：玻璃胶囊 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20mm" />
            <solid android:color="#12FFFFFF" />
            <stroke android:width="1mm" android:color="@color/home_surface_stroke" />
        </shape>
    </item>
</selector>
