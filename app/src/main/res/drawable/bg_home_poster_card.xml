<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 焦点态：蓝色细边，替代原来的粗白框 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8mm" />
            <solid android:color="@color/home_accent_soft" />
            <stroke android:width="2mm" android:color="@color/home_accent" />
        </shape>
    </item>
    <!-- 常态：几乎不可见的细边，让海报自身说话 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8mm" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1mm" android:color="@color/home_surface_stroke" />
        </shape>
    </item>
</selector>
